set(VCPKG_BUILD_TYPE release)

get_filename_component(_OVERLAY_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(_INSTALLED_DIR "${_OVERLAY_ROOT}/CommonLibSSE-NG-Installed")
set(_PREBUILT_DIR "${_OVERLAY_ROOT}/CommonLibSSE-NG-Prebuilt/cmake")
set(_SOURCE_DIR "${_OVERLAY_ROOT}/CommonLibSSE-NG")

if(EXISTS "${_INSTALLED_DIR}/lib/CommonLibSSE.lib")
    message(STATUS "Using local pre-installed CommonLibSSE-NG from ${_INSTALLED_DIR}")
    file(COPY "${_INSTALLED_DIR}/include" DESTINATION "${CURRENT_PACKAGES_DIR}")
    file(COPY "${_INSTALLED_DIR}/lib" DESTINATION "${CURRENT_PACKAGES_DIR}")
    file(MAKE_DIRECTORY "${CURRENT_PACKAGES_DIR}/share")
    if(EXISTS "${_INSTALLED_DIR}/lib/cmake/CommonLibSSE")
        file(COPY "${_INSTALLED_DIR}/lib/cmake/CommonLibSSE" DESTINATION "${CURRENT_PACKAGES_DIR}/share")
        file(REMOVE_RECURSE "${CURRENT_PACKAGES_DIR}/lib/cmake")
    endif()
elseif(EXISTS "${_PREBUILT_DIR}/lib/CommonLibSSE.lib")
    message(STATUS "Using local prebuilt CommonLibSSE-NG from ${_PREBUILT_DIR}")
    file(COPY "${_PREBUILT_DIR}/include" DESTINATION "${CURRENT_PACKAGES_DIR}")
    if(EXISTS "${_PREBUILT_DIR}/extern/openvr/headers/openvr.h")
        file(COPY "${_PREBUILT_DIR}/extern/openvr/headers/openvr.h" DESTINATION "${CURRENT_PACKAGES_DIR}/include")
    endif()
    file(COPY "${_PREBUILT_DIR}/lib" DESTINATION "${CURRENT_PACKAGES_DIR}")
    file(MAKE_DIRECTORY "${CURRENT_PACKAGES_DIR}/share/CommonLibSSE")
    file(COPY "${_SOURCE_DIR}/cmake/CommonLibSSE.cmake" DESTINATION "${CURRENT_PACKAGES_DIR}/share/CommonLibSSE")
else()
    message(FATAL_ERROR "Local CommonLibSSE-NG prebuilt not found in ${_INSTALLED_DIR} or ${_PREBUILT_DIR}")
endif()

file(MAKE_DIRECTORY "${CURRENT_PACKAGES_DIR}/share/${PORT}")
file(WRITE "${CURRENT_PACKAGES_DIR}/share/${PORT}/copyright" "GPL-3.0-or-later with Modding Exception (https://github.com/alandtse/CommonLibSSE-NG)\n")
