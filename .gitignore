# Python bytecode & virtual environment
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/

# Working & output artifacts
workspace/*
dist/*
*.bak

# Portable third-party toolchains & local SDK installs (installed locally via SETUP.md; excluded from Nexus/GitHub archives)
tools/*
!tools/.gitkeep
sdk/*
!sdk/.gitkeep

# IDE / build intermediates
.vs/
